# Static-asset headers (Workers assets / Pages convention).
# The service worker and manifest must never be served stale, or an update
# could take up to a day to reach installed apps.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# Recorded clips (F-AUDIO-004 §3.10): Expo mirrors assets/audio/** under
# /assets/assets/audio/ with a content hash in every file name, so a clip
# never changes at its URL.
/assets/assets/audio/*
  Cache-Control: public, max-age=31536000, immutable
# Grown-up console chunks (F-APP-001 §3.3): from A-3 the console's Next build is copied
# into this Worker's dist; its hashed /_next/static files never change at their URL.
# Never precached by the learner worker; inert until A-3. Unlike apps/web (404-page),
# this Worker's single-page fallback answers a miss here with index.html, which this
# rule would let a browser keep for a year: A-3 answers a miss under /_next/ with a 404
# or drops this rule (§3.3).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
