# Static-asset headers (Workers assets / Pages convention).
# The service worker and manifest must never be served stale, or an update
# could take up to a day to reach installed apps.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# Recorded clips (F-AUDIO-004 §3.10): Expo mirrors assets/audio/** under
# /assets/assets/audio/ with a content hash in every file name, so a clip
# never changes at its URL.
/assets/assets/audio/*
  Cache-Control: public, max-age=31536000, immutable
# Grown-up console chunks (F-APP-001 §3.3, A-3): /_next/ gets no year-long rule here.
# Unlike apps/web (404-page), this Worker's single-page fallback answers a missing chunk
# with index.html, and an immutable rule would let a browser keep that page under the
# chunk URL for a year; the Worker stays assets-only (AD-1), so the rule is dropped and
# chunks revalidate. scripts/app-host/merge-console.mjs refuses a build that adds it back,
# and appends the grown-up page rules (§3.17) to the dist copy of this file.
