{
  "name": "@hangul-route/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Hangul Route mobile app (Expo React Native)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "echo '(no lint yet — @hangul-route/mobile)'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "echo '(no build output yet — @hangul-route/mobile)'",
    "audio:map": "node scripts/audio/gen-audio-map.mjs",
    "audio:script": "node scripts/audio/gen-recording-script.mjs",
    "audio:process": "node scripts/audio/process-recordings.mjs",
    "audio:check": "node scripts/audio/check-audio.mjs",
    "audio:status": "node scripts/audio/check-audio.mjs --status",
    "build:web": "node scripts/audio/gen-audio-map.mjs && expo export --platform web --output-dir dist && node scripts/app-host/merge-console.mjs dist && node scripts/pwa-postbuild.mjs dist",
    "build:web:fixtures": "node scripts/build-web-fixtures.mjs dist-e2e",
    "build:web:fixtures:gated": "node scripts/build-web-fixtures.mjs dist-e2e-gated --content-gating",
    "build:web:route": "node scripts/build-web-route.mjs",
    "serve:web": "node scripts/serve-dist.mjs dist",
    "test:e2e:web": "playwright test"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/metro-runtime": "~4.0.1",
    "@hangul-route/content-schema": "workspace:*",
    "@hangul-route/design-system": "workspace:*",
    "@hangul-route/i18n": "workspace:*",
    "@hangul-route/shared-types": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-clipboard": "~7.0.1",
    "expo-crypto": "~14.0.0",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.0",
    "expo-localization": "~16.0.1",
    "expo-network": "~7.0.5",
    "expo-sharing": "~13.0.0",
    "expo-speech": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "idb-keyval": "^6.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "^6.1.5",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-svg": "15.8.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.19.13",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@hangul-route/test-utils": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "18.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.135.0"
  }
}
