{
  "name": "@hangul-route/web",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Hangul Route web app (Next.js App Router) — landing + Parent Dashboard",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "echo '(no lint yet — @hangul-route/web)'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "build": "next build && node scripts/prune-hidden-locales.mjs out && node scripts/site-redirects.mjs out",
    "build:console": "next build && node scripts/console-split.mjs out && node scripts/prune-hidden-locales.mjs out",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/localizations": "3.37.2",
    "@hangul-route/content-schema": "workspace:*",
    "@hangul-route/design-system": "workspace:*",
    "@hangul-route/i18n": "workspace:*",
    "@hangul-route/shared-types": "workspace:*",
    "idb-keyval": "^6.3.0",
    "next": "^14.2.18",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@hangul-route/test-utils": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "18.3.1",
    "@vitest/coverage-v8": "^2.1.8",
    "jsqr": "1.4.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.135.0"
  }
}
