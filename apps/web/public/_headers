# Static-asset headers (Workers assets convention).
# HTML is never cached by the browser so a deploy reaches everyone on the next
# load; Next's hashed /_next/static files are immutable.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
