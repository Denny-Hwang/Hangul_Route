{
  "description": "An item level outside 1-3 fails the item schema.",
  "ops": [
    {
      "op": "set",
      "file": "vocab/food.json",
      "path": "items.0.level",
      "value": 9
    }
  ],
  "expect": [
    {
      "rule": "vocab-schema",
      "file": "vocab/food.json",
      "includes": "items.0.level"
    }
  ]
}
