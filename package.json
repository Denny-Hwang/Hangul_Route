{
  "name": "hangul-route",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Hangul Route — learn Hangul from zero, at any age (heritage families, K-culture fans, beginners)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "generate": "node scripts/generate.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "vocab:build": "node scripts/build-vocab.mjs",
    "vocab:check": "node scripts/build-vocab.mjs --check",
    "postinstall": "node scripts/generate.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
